{
  "name": "connectcoin-beauty-wallet",
  "productName": "ConnectCoin Beauty Wallet",
  "version": "0.1.0",
  "description": "A local-key, light ConnectCoin wallet with BIP39 recovery and Automatic Claims",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "author": "ConnectCoin contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/connectcoincrypto/connectcoin-beauty-wallet.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:regtest": "node scripts/crypto-regtest.mjs",
    "setup:claims": "node scripts/setup-claims.mjs",
    "build:claims": "node scripts/setup-claims.mjs --build",
    "build:icon": "node scripts/build-icon.mjs",
    "prepack": "node scripts/check-package.mjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/check-package.mjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.connectcoincrypto.beautywallet",
    "asar": true,
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "helpers/bin/beauty-claims",
        "to": "claims-helper"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Beauty-Wallet-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  }
}
